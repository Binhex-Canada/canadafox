+  // CanadaFox: pin the first-run welcome tab (startup.homepage_welcome_url)
+  // so it persists across restarts like any other pinned tab, instead of
+  // only ever showing once. It sticks around until the user closes it.
+  _maybePinFirstRunWelcomeTab(aWindow) {
+    if (!lazy.BrowserHandler.firstRunProfile) {
+      return;
+    }
+    let welcomeURL = Services.urlFormatter.formatURLPref(
+      "startup.homepage_welcome_url"
+    );
+    if (!welcomeURL) {
+      return;
+    }
+    for (let tab of aWindow.gBrowser.tabs) {
+      if (tab.linkedBrowser?.currentURI?.spec == welcomeURL) {
+        aWindow.gBrowser.pinTab(tab);
+        break;
+      }
+    }
+  },
