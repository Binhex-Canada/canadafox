+  // CanadaFox: "Sovereign Privacy" toggle for CIRA Canadian Shield DNS.
+  // policies.json sets the *default* branch (network.trr.mode/uri), which
+  // is what a fresh profile gets; this maps our own boolean pref onto the
+  // *user* branch so it can be flipped from Settings without a restart,
+  // and reapplies live so toggling takes effect immediately.
+  PREF_CIRA_DNS_ENABLED: "canadafox.dns.ciraEnabled",
+  CIRA_DNS_URI: "https://protected.canadianshield.cira.ca/dns-query",
+
+  _initCiraDnsToggle() {
+    this._applyCiraDnsSetting();
+    Services.prefs.addObserver(this.PREF_CIRA_DNS_ENABLED, () =>
+      this._applyCiraDnsSetting()
+    );
+  },
+
+  _applyCiraDnsSetting() {
+    if (Services.prefs.getBoolPref(this.PREF_CIRA_DNS_ENABLED, true)) {
+      Services.prefs.setIntPref("network.trr.mode", 2);
+      Services.prefs.setStringPref("network.trr.uri", this.CIRA_DNS_URI);
+    } else {
+      // Mode 0: native OS DNS only, same as a stock Firefox profile that
+      // has never had DoH configured. Not "fall back to a different DoH
+      // provider" -- this toggle is specifically about CIRA.
+      Services.prefs.setIntPref("network.trr.mode", 0);
+    }
+  },
+
