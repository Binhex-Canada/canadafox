+  // CanadaFox: keep the "Canadian Services" bookmarks folder topped up with
+  // every entry we ship, on every startup. distribution.ini's bookmark
+  // import (see browser/app/distribution/distribution.ini) only ever runs
+  // once per profile, so any entry added in a later CanadaFox version would
+  // never reach a profile that already existed -- confirmed missing entries
+  // on a real, already-used profile after adding two more here. Checking by
+  // URL and inserting only what's missing means this is safe to run every
+  // launch, and doesn't touch anything the user has since moved or renamed.
+  CANADAFOX_BOOKMARKS_FOLDER_TITLE: "Canadian Services",
+  CANADAFOX_BOOKMARKS: [
+    {
+      title: "Canada Revenue Agency (CRA)",
+      url: "https://www.canada.ca/en/revenue-agency.html",
+    },
+    {
+      title: "Service Canada",
+      url: "https://www.canada.ca/en/employment-social-development/corporate/portfolio/service-canada.html",
+    },
+    {
+      title: "Canada.ca — Health",
+      url: "https://www.canada.ca/en/services/health.html",
+    },
+    { title: "CBC News", url: "https://www.cbc.ca/news" },
+    {
+      title: "Canada Benefits Finder",
+      url: "https://www.canada.ca/en/services/benefits/finder.html",
+    },
+    {
+      title: "BC Services A-Z",
+      url: "https://www2.gov.bc.ca/gov/content/home/services-a-z",
+    },
+  ],
+
+  async _ensureCanadianServicesBookmarks() {
+    // distribution.ini's own bookmark import runs later, asynchronously,
+    // from a separate startup path (PlacesBrowserStartup.sys.mjs) that
+    // isn't awaited here. On a genuinely new profile it's the authoritative
+    // (and race-free, since it owns folder creation) way these bookmarks
+    // get created, so defer to it entirely rather than risk this code and
+    // that import both deciding the folder doesn't exist yet and each
+    // creating one. Mirrors distribution.sys.mjs's own newProfile check.
+    if (!Services.prefs.prefHasUserValue("browser.migration.version")) {
+      return;
+    }
+    try {
+      let db = await lazy.PlacesUtils.promiseDBConnection();
+      let rows = await db.executeCached(
+        `SELECT b.guid FROM moz_bookmarks b
+         JOIN moz_bookmarks p ON b.parent = p.id
+         WHERE p.guid = :toolbarGuid AND b.title = :title AND b.type = :folderType
+         LIMIT 1`,
+        {
+          toolbarGuid: lazy.PlacesUtils.bookmarks.toolbarGuid,
+          title: this.CANADAFOX_BOOKMARKS_FOLDER_TITLE,
+          folderType: lazy.PlacesUtils.bookmarks.TYPE_FOLDER,
+        }
+      );
+
+      let folderGuid;
+      if (rows.length) {
+        folderGuid = rows[0].getResultByName("guid");
+      } else {
+        let folder = await lazy.PlacesUtils.bookmarks.insert({
+          type: lazy.PlacesUtils.bookmarks.TYPE_FOLDER,
+          parentGuid: lazy.PlacesUtils.bookmarks.toolbarGuid,
+          title: this.CANADAFOX_BOOKMARKS_FOLDER_TITLE,
+        });
+        folderGuid = folder.guid;
+      }
+
+      for (let { title, url } of this.CANADAFOX_BOOKMARKS) {
+        if (await lazy.PlacesUtils.bookmarks.fetch({ url })) {
+          continue;
+        }
+        await lazy.PlacesUtils.bookmarks.insert({
+          parentGuid: folderGuid,
+          title,
+          url,
+        });
+      }
+    } catch (ex) {
+      console.error(
+        "CanadaFox: failed to ensure Canadian Services bookmarks",
+        ex
+      );
+    }
+  },
+
