+// CanadaFox: real Heritage Minutes (Historica Canada's long-running short-film
+// series), shown as a small blurb on genuine network errors. Deliberately not
+// shown on certificate/security error pages -- initPage() only reaches the
+// call site for regular net errors, cert errors return earlier.
+const CANADAFOX_HERITAGE_MINUTES = [
+  {
+    title: "Basketball",
+    blurb:
+      "In 1891, Ontario-born James Naismith invented basketball while teaching physical education in Springfield, Massachusetts \u2014 using a soccer ball and two peach baskets.",
+  },
+  {
+    title: "Superman",
+    blurb:
+      "Toronto-born Joe Shuster co-created Superman with writer Jerry Siegel in the 1930s, drawing the character for the very first comics.",
+  },
+  {
+    title: "Winnie",
+    blurb:
+      "In 1914, Canadian soldier Harry Colebourn bought a bear cub and named her Winnie, after his hometown of Winnipeg \u2014 she later inspired Winnie-the-Pooh.",
+  },
+  {
+    title: "Peacekeeping",
+    blurb:
+      "Lester B. Pearson won the 1957 Nobel Peace Prize for proposing the United Nations' first large-scale peacekeeping force during the Suez Crisis.",
+  },
+  {
+    title: "Burnt Toast",
+    blurb:
+      "Neurosurgeon Wilder Penfield mapped the brain by stimulating regions during surgery on awake patients \u2014 in one case, triggering a patient's vivid memory of the smell of burnt toast.",
+  },
+  {
+    title: "Jackie Robinson",
+    blurb:
+      "Before breaking Major League Baseball's colour barrier, Jackie Robinson played his first professional game for the Montreal Royals in 1946.",
+  },
+  {
+    title: "Bombardier",
+    blurb:
+      "Qu\u00e9bec inventor Joseph-Armand Bombardier patented the snowmobile in the 1930s, building vehicles that could travel over deep snow.",
+  },
+  {
+    title: "Halifax Explosion",
+    blurb:
+      "During the 1917 Halifax Explosion, train dispatcher Vince Coleman stayed at his telegraph key to warn incoming trains of the danger, saving hundreds of lives.",
+  },
+  {
+    title: "Laura Secord",
+    blurb:
+      "During the War of 1812, Laura Secord walked roughly 30 km through enemy territory to warn British and Canadian forces of an American attack.",
+  },
+];
+
+function initCanadaFoxHeritageMinute() {
+  const container = document.getElementById("canadafoxHeritageMinute");
+  if (!container) {
+    return;
+  }
+  const dayOfYear = Math.floor(
+    (Date.now() - new Date(new Date().getFullYear(), 0, 0)) / 86400000
+  );
+  const entry =
+    CANADAFOX_HERITAGE_MINUTES[dayOfYear % CANADAFOX_HERITAGE_MINUTES.length];
+  document.getElementById("canadafoxHeritageMinuteTitle").textContent =
+    `Heritage Minutes: ${entry.title}`;
+  document.getElementById("canadafoxHeritageMinuteBlurb").textContent =
+    entry.blurb;
+  container.hidden = false;
+}
+
 function initPage() {
   // We show an offline support page in case of a system-wide error,
   // when a user cannot connect to the internet and access the SUMO website.
