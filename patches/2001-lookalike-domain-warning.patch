diff --git a/browser/components/CanadaFoxLookalikeProtection.sys.mjs b/browser/components/CanadaFoxLookalikeProtection.sys.mjs
new file mode 100644
index 0000000000..19eabc48a0
--- /dev/null
+++ b/browser/components/CanadaFoxLookalikeProtection.sys.mjs
@@ -0,0 +1,252 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// CanadaFox: warns before navigating to a domain that closely mimics one of
+// a small set of frequently-impersonated sites -- Canadian government and
+// banking services plus a handful of major global brands commonly used as
+// phishing lures (e.g. "cra-refund-canada.com", "microsoft-support-alert.com").
+// Entirely local: no network requests, no telemetry, just a bundled domain
+// list and a similarity check run against the eTLD+1 of every top-level
+// navigation, using the same JS content-policy mechanism enterprise policy's
+// WebsiteFilter uses (see enterprisepolicies/helpers/WebsiteFilter.sys.mjs).
+
+const PREF_ENABLED = "canadafox.lookalikeProtection.enabled";
+const WARNING_PAGE = "about:canadafoxlookalike";
+const OVERRIDE_FRAGMENT = "canadafox-lookalike-override";
+
+const CONTENT_POLICY_CID = Components.ID(
+  "{5f2b6e9a-3c1d-4b7a-9e2f-1a6d8c4b7e93}"
+);
+const CONTENT_POLICY_CONTRACT_ID =
+  "@canadafox.ca/lookalike-domain-content-policy;1";
+
+// eTLD+1 (registrable domain) for each protected site. Kept intentionally
+// small and specific -- this catches phishing of Canada's most commonly
+// impersonated government/financial services plus a handful of global
+// brands, not a general-purpose blocklist.
+export const CANADAFOX_PROTECTED_DOMAINS = [
+  "canada.ca",
+  "cra-arc.gc.ca",
+  "servicecanada.gc.ca",
+  "rbc.com",
+  "royalbank.com",
+  "td.com",
+  "scotiabank.com",
+  "bmo.com",
+  "cibc.com",
+  "interac.ca",
+  "desjardins.com",
+  "canadapost.ca",
+  "microsoft.com",
+  "apple.com",
+  "google.com",
+  "paypal.com",
+  "amazon.com",
+  "netflix.com",
+];
+
+function levenshtein(a, b) {
+  const n = b.length;
+  const dp = new Array(n + 1);
+  for (let j = 0; j <= n; j++) {
+    dp[j] = j;
+  }
+  for (let i = 1; i <= a.length; i++) {
+    let prev = dp[0];
+    dp[0] = i;
+    for (let j = 1; j <= n; j++) {
+      const tmp = dp[j];
+      dp[j] = Math.min(
+        dp[j] + 1,
+        dp[j - 1] + 1,
+        prev + (a[i - 1] === b[j - 1] ? 0 : 1)
+      );
+      prev = tmp;
+    }
+  }
+  return dp[n];
+}
+
+// Normalizes common character substitutions used in lookalike domains
+// ("rn" -> "m", "0"/"1" -> "o"/"l", ...) before comparing, so e.g.
+// "arnaz0n" and "amazon" compare as the same label.
+function normalizeConfusables(label) {
+  return label
+    .replace(/rn/g, "m")
+    .replace(/vv/g, "w")
+    .replace(/0/g, "o")
+    .replace(/1/g, "l")
+    .replace(/3/g, "e")
+    .replace(/5/g, "s")
+    .replace(/\$/g, "s");
+}
+
+function firstLabel(domain) {
+  return domain.split(".")[0];
+}
+
+// Returns the protected domain a given host appears to be impersonating, or
+// null if the host is safe (either the real domain, one of its subdomains,
+// or unrelated to any protected domain).
+export function findLookalikeMatch(host) {
+  let baseDomain;
+  try {
+    baseDomain = Services.eTLD.getBaseDomainFromHost(host).toLowerCase();
+  } catch (e) {
+    return null;
+  }
+  if (!baseDomain || CANADAFOX_PROTECTED_DOMAINS.includes(baseDomain)) {
+    return null;
+  }
+
+  const candidateLabel = normalizeConfusables(firstLabel(baseDomain));
+
+  for (const protectedDomain of CANADAFOX_PROTECTED_DOMAINS) {
+    const protectedLabel = normalizeConfusables(firstLabel(protectedDomain));
+
+    if (candidateLabel === protectedLabel) {
+      // Same brand name, different eTLD+1 -- wrong suffix/TLD, e.g.
+      // "cra-arc.gc.ca.com" or "rbc.net" instead of "rbc.com".
+      return protectedDomain;
+    }
+    if (
+      candidateLabel.length >= 4 &&
+      levenshtein(candidateLabel, protectedLabel) <= 1
+    ) {
+      return protectedDomain;
+    }
+    // Brand name with extra words tacked on, e.g. "microsoft-support-alert"
+    // or "rbc-secure-login". Threshold of 3 excludes only very short labels
+    // ("td") from this specific check, since a 2-letter prefix/suffix match
+    // is too common to be meaningful; "td" is still caught by the exact- and
+    // edit-distance checks above.
+    if (
+      protectedLabel.length >= 3 &&
+      (candidateLabel.startsWith(protectedLabel + "-") ||
+        candidateLabel.endsWith("-" + protectedLabel))
+    ) {
+      return protectedDomain;
+    }
+  }
+  return null;
+}
+
+export const CanadaFoxLookalikeProtection = {
+  _registered: false,
+
+  init() {
+    this._applyEnabledSetting();
+    Services.prefs.addObserver(PREF_ENABLED, () =>
+      this._applyEnabledSetting()
+    );
+  },
+
+  _applyEnabledSetting() {
+    if (Services.prefs.getBoolPref(PREF_ENABLED, true)) {
+      this._register();
+    } else {
+      this._unregister();
+    }
+  },
+
+  _register() {
+    if (this._registered) {
+      return;
+    }
+    const registrar = Components.manager.QueryInterface(
+      Ci.nsIComponentRegistrar
+    );
+    if (!registrar.isContractIDRegistered(CONTENT_POLICY_CONTRACT_ID)) {
+      registrar.registerFactory(
+        CONTENT_POLICY_CID,
+        "CanadaFox Lookalike Domain Content Policy",
+        CONTENT_POLICY_CONTRACT_ID,
+        this
+      );
+      Services.catMan.addCategoryEntry(
+        "content-policy",
+        CONTENT_POLICY_CONTRACT_ID,
+        CONTENT_POLICY_CONTRACT_ID,
+        false,
+        true
+      );
+    }
+    this._registered = true;
+  },
+
+  _unregister() {
+    if (!this._registered) {
+      return;
+    }
+    Services.catMan.deleteCategoryEntry(
+      "content-policy",
+      CONTENT_POLICY_CONTRACT_ID,
+      false
+    );
+    const registrar = Components.manager.QueryInterface(
+      Ci.nsIComponentRegistrar
+    );
+    registrar.unregisterFactory(CONTENT_POLICY_CID, this);
+    this._registered = false;
+  },
+
+  shouldLoad(contentLocation, loadInfo) {
+    if (
+      loadInfo.externalContentPolicyType !== Ci.nsIContentPolicy.TYPE_DOCUMENT
+    ) {
+      return Ci.nsIContentPolicy.ACCEPT;
+    }
+    if (contentLocation.scheme !== "http" && contentLocation.scheme !== "https") {
+      return Ci.nsIContentPolicy.ACCEPT;
+    }
+    // Set by the "continue anyway" link on the warning page itself.
+    if (contentLocation.ref === OVERRIDE_FRAGMENT) {
+      return Ci.nsIContentPolicy.ACCEPT;
+    }
+
+    let host;
+    try {
+      host = contentLocation.host;
+    } catch (e) {
+      return Ci.nsIContentPolicy.ACCEPT;
+    }
+
+    const match = findLookalikeMatch(host);
+    if (!match) {
+      return Ci.nsIContentPolicy.ACCEPT;
+    }
+
+    const browsingContext = loadInfo.browsingContext?.top;
+    const browser = browsingContext?.embedderElement;
+    if (!browser) {
+      return Ci.nsIContentPolicy.ACCEPT;
+    }
+
+    const warningURL = `${WARNING_PAGE}?target=${encodeURIComponent(
+      contentLocation.spec
+    )}&real=${encodeURIComponent(match)}`;
+    Services.tm.dispatchToMainThread(() => {
+      try {
+        browser.loadURI(Services.io.newURI(warningURL), {
+          triggeringPrincipal:
+            Services.scriptSecurityManager.getSystemPrincipal(),
+        });
+      } catch (e) {}
+    });
+
+    return Ci.nsIContentPolicy.REJECT_REQUEST;
+  },
+
+  shouldProcess() {
+    return Ci.nsIContentPolicy.ACCEPT;
+  },
+
+  classDescription: "CanadaFox Lookalike Domain Content Policy",
+  contractID: CONTENT_POLICY_CONTRACT_ID,
+  classID: CONTENT_POLICY_CID,
+  QueryInterface: ChromeUtils.generateQI(["nsIContentPolicy"]),
+  createInstance(iid) {
+    return this.QueryInterface(iid);
+  },
+};
