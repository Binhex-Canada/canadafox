+<!-- This Source Code Form is subject to the terms of the Mozilla Public
+   - License, v. 2.0. If a copy of the MPL was not distributed with this
+   - file, You can obtain one at http://mozilla.org/MPL/2.0/. -->
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<title>Possible lookalike site</title>
+<style>
+  html, body {
+    margin: 0;
+    height: 100%;
+    background: #2b0a0a;
+    color: #fff;
+    font-family: -apple-system, "Helvetica Neue", Arial, sans-serif;
+  }
+  body {
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    padding: 40px 24px;
+    box-sizing: border-box;
+  }
+  main {
+    max-width: 560px;
+  }
+  h1 {
+    font-size: 22px;
+    line-height: 1.35;
+    margin: 0 0 20px;
+  }
+  p {
+    font-size: 15px;
+    line-height: 1.6;
+    color: rgba(255, 255, 255, 0.85);
+  }
+  .address {
+    font-family: ui-monospace, Menlo, Consolas, monospace;
+    word-break: break-all;
+    background: rgba(255, 255, 255, 0.08);
+    padding: 10px 12px;
+    border-radius: 4px;
+  }
+  .hint {
+    color: rgba(255, 255, 255, 0.7);
+  }
+  .hint strong {
+    color: #fff;
+  }
+  .buttons {
+    margin-top: 28px;
+  }
+  button {
+    font-size: 15px;
+    font-weight: 600;
+    padding: 10px 20px;
+    border-radius: 4px;
+    border: none;
+    background: #fff;
+    color: #2b0a0a;
+    cursor: pointer;
+  }
+  button:hover {
+    background: rgba(255, 255, 255, 0.85);
+  }
+  .continue {
+    margin-top: 18px;
+    font-size: 13px;
+  }
+  .continue a {
+    color: rgba(255, 255, 255, 0.6);
+  }
+</style>
+</head>
+<body>
+<main>
+  <h1>⚠️ This site may not be what it claims to be</h1>
+  <p class="address" id="targetLine"></p>
+  <p class="hint">
+    CanadaFox flagged this address because it closely resembles
+    <strong id="realDomain"></strong> but isn't it. This is a common trick
+    used in phishing and scam sites -- often to impersonate government
+    services, banks, or tech support. Checked entirely on this device;
+    nothing was sent anywhere to produce this warning.
+  </p>
+  <div class="buttons">
+    <button id="goBack">Go back to safety</button>
+  </div>
+  <p class="continue">
+    <a id="continueLink" href="#">I understand the risk -- continue anyway</a>
+  </p>
+</main>
+<script>
+  const params = new URLSearchParams(location.search);
+  const target = params.get("target") || "";
+  const real = params.get("real") || "";
+
+  document.getElementById("targetLine").textContent = target;
+  document.getElementById("realDomain").textContent = real;
+
+  document.getElementById("goBack").addEventListener("click", () => {
+    if (history.length > 1) {
+      history.back();
+    } else {
+      location.href = "about:home";
+    }
+  });
+
+  const continueLink = document.getElementById("continueLink");
+  try {
+    const url = new URL(target);
+    url.hash = "canadafox-lookalike-override";
+    continueLink.href = url.href;
+  } catch (e) {
+    continueLink.remove();
+  }
+</script>
+</body>
+</html>
