   document.getElementById("fact").textContent = fact;
   document.getElementById("label").textContent = label;
+
+  // General statutory sales tax rates by province/territory. Kept in sync
+  // by hand with UrlbarProviderCanadianTax.sys.mjs's copy of the same table.
+  var PROVINCE_TAX = [
+    ["ab", "Alberta", 5, 0, 0],
+    ["bc", "British Columbia", 5, 7, 0],
+    ["mb", "Manitoba", 5, 7, 0],
+    ["nb", "New Brunswick", 0, 0, 15],
+    ["nl", "Newfoundland and Labrador", 0, 0, 15],
+    ["ns", "Nova Scotia", 0, 0, 14],
+    ["nt", "Northwest Territories", 5, 0, 0],
+    ["nu", "Nunavut", 5, 0, 0],
+    ["on", "Ontario", 0, 0, 13],
+    ["pe", "Prince Edward Island", 0, 0, 15],
+    ["qc", "Quebec", 5, 9.975, 0],
+    ["sk", "Saskatchewan", 5, 6, 0],
+    ["yt", "Yukon", 5, 0, 0]
+  ];
+
+  var provinceSelect = document.getElementById("calc-province");
+  PROVINCE_TAX.forEach(function (row) {
+    var option = document.createElement("option");
+    option.value = row[0];
+    option.textContent = row[1];
+    provinceSelect.appendChild(option);
+  });
+  provinceSelect.value = "on";
+
+  function formatCurrency(n) {
+    return n.toLocaleString(undefined, {
+      minimumFractionDigits: 2,
+      maximumFractionDigits: 2
+    });
+  }
+
+  var lastResultText = "";
+
+  function updateCalc() {
+    var amountInput = document.getElementById("calc-amount");
+    var amount = parseFloat(amountInput.value);
+    var resultEl = document.getElementById("calc-result");
+    if (!isFinite(amount) || amount <= 0) {
+      resultEl.textContent = "";
+      lastResultText = "";
+      return;
+    }
+
+    var row = PROVINCE_TAX.filter(function (r) {
+      return r[0] === provinceSelect.value;
+    })[0];
+    var gst = row[2], pst = row[3], hst = row[4];
+    var total = amount + (amount * (gst + pst + hst)) / 100;
+
+    var breakdown;
+    if (hst) {
+      breakdown = hst + "% HST";
+    } else if (pst) {
+      breakdown = gst + "% GST + " + pst + "% PST";
+    } else {
+      breakdown = gst + "% GST";
+    }
+
+    lastResultText = "$" + formatCurrency(total);
+    resultEl.textContent = "$" + formatCurrency(amount) + " + " + breakdown + " = " + lastResultText;
+  }
+
+  document.getElementById("calc-amount").addEventListener("input", updateCalc);
+  provinceSelect.addEventListener("change", updateCalc);
+  document.getElementById("calc-copy").addEventListener("click", function () {
+    if (!lastResultText) {
+      return;
+    }
+    navigator.clipboard.writeText(lastResultText.replace("$", ""));
+    var button = document.getElementById("calc-copy");
+    var original = button.textContent;
+    button.textContent = "Copied!";
+    setTimeout(function () {
+      button.textContent = original;
+    }, 1200);
+  });
+
+  updateCalc();
 </script>
