--- a/browser/components/BrowserGlue.sys.mjs
+++ b/browser/components/BrowserGlue.sys.mjs
@@ -404,6 +404,7 @@ BrowserGlue.prototype = {
     lazy.DistributionManagement.applyCustomizations();
 
     this._initCiraDnsToggle();
+    this._initSharperImagesToggle();
     this._initKeywordShortcuts();
     this._ensureCanadianServicesBookmarks();
 
@@ -453,6 +454,40 @@ BrowserGlue.prototype = {
     }
   },
 
+  // CanadaFox: "Sharper images" toggle. layout.css.devPixelsPerPx is a
+  // genuine Gecko rendering pref -- the same one that makes a Retina
+  // display look sharper than a standard one, at the same CSS/layout
+  // size. Forcing it higher makes Firefox's own <img srcset>/<picture>
+  // candidate selection prefer higher-resolution variants sites already
+  // publish for HiDPI screens, with no network changes and no AI
+  // upscaling. Off by default: it costs real bandwidth and GPU work, and
+  // does nothing on sites that only publish one resolution.
+  PREF_SHARPER_IMAGES_ENABLED: "canadafox.sharperImages.enabled",
+  SHARPER_IMAGES_DEV_PIXELS_PER_PX: 2.0,
+
+  _initSharperImagesToggle() {
+    this._applySharperImagesSetting();
+    Services.prefs.addObserver(this.PREF_SHARPER_IMAGES_ENABLED, () =>
+      this._applySharperImagesSetting()
+    );
+  },
+
+  _applySharperImagesSetting() {
+    // nsIPrefBranch has no setFloatPref -- layout.css.devPixelsPerPx (like
+    // all float-typed prefs) is stored as a plain numeric string and parsed
+    // on read; getFloatPref exists only as a scriptable convenience getter.
+    if (Services.prefs.getBoolPref(this.PREF_SHARPER_IMAGES_ENABLED, false)) {
+      Services.prefs.setCharPref(
+        "layout.css.devPixelsPerPx",
+        String(this.SHARPER_IMAGES_DEV_PIXELS_PER_PX)
+      );
+    } else {
+      // -1 means "choose automatically based on the platform", i.e. stock
+      // Firefox behaviour (Retina Macs already report 2 on their own).
+      Services.prefs.setCharPref("layout.css.devPixelsPerPx", "-1");
+    }
+  },
+
