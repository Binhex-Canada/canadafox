diff --git a/browser/modules/AboutNewTab.sys.mjs b/browser/modules/AboutNewTab.sys.mjs
index 4d6b04e72b..08ea2aeb4d 100644
--- a/browser/modules/AboutNewTab.sys.mjs
+++ b/browser/modules/AboutNewTab.sys.mjs
@@ -19,6 +19,12 @@ ChromeUtils.defineESModuleGetters(lazy, {
 });
 
 const ABOUT_URL = "about:newtab";
+// CanadaFox: every new tab shows a self-contained page (no network request)
+// that rotates through Canadian trivia, or an "on this day" fact when
+// today's date matches one. Registered as a real about: page (see
+// AboutRedirector.cpp) rather than a data: URI, since data: URIs get a
+// null principal and always show in full in the address bar.
+const CANADAFOX_NEW_TAB_URL = "about:canadafoxnewtab";
 const PREF_ACTIVITY_STREAM_DEBUG = "browser.newtabpage.activity-stream.debug";
 // AboutHomeStartupCache needs us in "quit-application", so stay alive longer.
 // TODO: We could better have a shared async shutdown blocker?
@@ -44,8 +50,11 @@ export const AboutNewTab = {
 
   _cachedTopSites: null,
 
-  _newTabURL: ABOUT_URL,
-  _newTabURLOverridden: false,
+  // CanadaFox: seed both fields (not just the default URL) so init()'s
+  // toggleActivityStream(true) call doesn't stomp this back to ABOUT_URL --
+  // it only resets _newTabURL when _newTabURLOverridden is still false.
+  _newTabURL: CANADAFOX_NEW_TAB_URL,
+  _newTabURLOverridden: true,
 
   /**
    * init - Initializes an instance of Activity Stream if one doesn't exist already.
diff --git a/browser/branding/unofficial/content/canada-newtab.html b/browser/branding/unofficial/content/canada-newtab.html
new file mode 100644
index 0000000000..0a15512b52
--- /dev/null
+++ b/browser/branding/unofficial/content/canada-newtab.html
@@ -0,0 +1,124 @@
+<!-- This Source Code Form is subject to the terms of the Mozilla Public
+   - License, v. 2.0. If a copy of the MPL was not distributed with this
+   - file, You can obtain one at http://mozilla.org/MPL/2.0/. -->
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<title>New Tab</title>
+<style>
+  html, body {
+    margin: 0;
+    height: 100%;
+    background: #130829;
+    color: #fff;
+    font-family: -apple-system, "Helvetica Neue", Arial, sans-serif;
+  }
+  body {
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    padding: 40px 24px;
+    box-sizing: border-box;
+  }
+  main {
+    max-width: 640px;
+    text-align: center;
+  }
+  h1 {
+    font-size: 20px;
+    font-weight: 700;
+    letter-spacing: 0.02em;
+    text-transform: uppercase;
+    color: #d64550;
+    margin: 0 0 28px;
+  }
+  p.fact {
+    margin: 0;
+    font-size: 24px;
+    line-height: 1.5;
+    font-weight: 600;
+  }
+  p.label {
+    margin: 28px 0 0;
+    font-size: 15px;
+    line-height: 1.7;
+    color: rgba(255, 255, 255, 0.7);
+  }
+</style>
+</head>
+<body>
+<main>
+  <h1>CanadaFox</h1>
+  <p class="fact" id="fact"></p>
+  <p class="label" id="label"></p>
+</main>
+<script>
+  var TRIVIA = [
+    "Canada has the longest coastline of any country on Earth, touching the Atlantic, Pacific, and Arctic oceans.",
+    "The name “Canada” likely comes from the Huron-Iroquois word “kanata,” meaning “village” or “settlement.”",
+    "Canada is the second-largest country in the world by area, after Russia.",
+    "Basketball was invented in 1891 by Canadian physical education teacher James Naismith.",
+    "Insulin was discovered in 1921 by Canadians Frederick Banting and Charles Best at the University of Toronto.",
+    "Canada has more lakes than the rest of the world's countries combined.",
+    "Canadian banknotes are made of polymer, not paper, making them harder to counterfeit and more durable.",
+    "The Canadarm, a robotic arm built in Canada, has flown on NASA Space Shuttle missions and the International Space Station.",
+    "Canada is the world's largest producer of maple syrup, supplying about 70% of the global market.",
+    "Quebec City is the only walled city in North America north of Mexico.",
+    "Canada's motto, “A Mari Usque Ad Mare,” is Latin for “From Sea to Sea.”",
+    "The $1 and $2 coins are nicknamed the “loonie” and “toonie,” after the loon on the dollar coin.",
+    "Nunavut became Canada's newest territory in 1999.",
+    "Canada has ten provinces and three territories.",
+    "Toronto's CN Tower was the world's tallest free-standing structure for more than 30 years after opening in 1976.",
+    "Tim Hortons, now one of Canada's best-known brands, opened its first shop in Hamilton, Ontario, in 1964.",
+    "Wayne Gretzky holds more NHL scoring records than any other player in league history.",
+    "Snag, Yukon recorded North America's coldest-ever temperature: -63°C, on February 3, 1947.",
+    "Lacrosse and ice hockey are both, by law, recognized as Canada's national sports — lacrosse in summer, hockey in winter.",
+    "The Trans-Canada Highway stretches roughly 8,000 km coast to coast, one of the longest national highways on Earth.",
+    "Canada Post postal codes always alternate letters and numbers: letter-number-letter, number-letter-number.",
+    "The RCMP's red-serge dress uniform is one of the most recognized national symbols in the world.",
+    "Canada has two official languages, English and French, enshrined since 1969.",
+    "Niagara Falls, among the most visited natural wonders on Earth, sits partly in Ontario.",
+    "The Canadian Pacific Railway, completed in 1885, was the first transcontinental railway to link Canada coast to coast."
+  ];
+
+  var ON_THIS_DAY = {
+    "07-01": [
+      "On July 1, 1867, the British North America Act united Ontario, Quebec, Nova Scotia, and New Brunswick into the Dominion of Canada — Confederation.",
+      "On July 1, 1873, Prince Edward Island joined Confederation as Canada's seventh province."
+    ],
+    "02-15": ["On February 15, 1965, Canada's current red-and-white maple leaf flag flew for the first time — now marked each year as National Flag of Canada Day."],
+    "04-17": ["On April 17, 1982, the Canadian Charter of Rights and Freedoms was proclaimed, patriating Canada's constitution from the United Kingdom."],
+    "03-31": ["On March 31, 1949, Newfoundland joined Confederation as Canada's tenth province."],
+    "09-01": ["On September 1, 1905, Alberta and Saskatchewan both became provinces on the very same day."],
+    "07-15": ["On July 15, 1870, Manitoba joined Confederation as Canada's fifth province."],
+    "07-20": ["On July 20, 1871, British Columbia joined Confederation, on the promise of a transcontinental railway."],
+    "11-07": ["On November 7, 1885, the “Last Spike” was driven at Craigellachie, BC, completing the Canadian Pacific Railway."],
+    "06-21": ["June 21 is National Indigenous Peoples Day in Canada, marked since 1996 to honour First Nations, Inuit, and Métis cultures and heritage."],
+    "10-14": ["On October 14, 1904, Prime Minister Sir Wilfrid Laurier told a Toronto crowd the 20th century would belong to Canada — the same speech quoted on CanadaFox's first-run page."]
+  };
+
+  function pad(n) { return n < 10 ? "0" + n : "" + n; }
+  function dayOfYear(d) {
+    var start = new Date(d.getFullYear(), 0, 0);
+    return Math.floor((d - start) / 86400000);
+  }
+
+  var now = new Date();
+  var key = pad(now.getMonth() + 1) + "-" + pad(now.getDate());
+  var doy = dayOfYear(now);
+  var onThisDay = ON_THIS_DAY[key];
+  var fact, label;
+  if (onThisDay && onThisDay.length) {
+    fact = onThisDay[doy % onThisDay.length];
+    label = "On this day in Canadian history";
+  } else {
+    fact = TRIVIA[doy % TRIVIA.length];
+    label = "Did you know?";
+  }
+
+  document.getElementById("fact").textContent = fact;
+  document.getElementById("label").textContent = label;
+</script>
+</body>
+</html>
