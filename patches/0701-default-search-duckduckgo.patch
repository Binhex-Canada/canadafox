diff --git a/browser/app/distribution/moz.build b/browser/app/distribution/moz.build
index b174449a09..4ebeab9cb4 100644
--- a/browser/app/distribution/moz.build
+++ b/browser/app/distribution/moz.build
@@ -8,3 +8,11 @@ if CONFIG["BUILT_BY_MOZILLA"]:
     FINAL_TARGET_FILES.distribution += [
         "distribution.ini",
     ]
+
+# CanadaFox: ship an enterprise-policy file so the default search
+# engine is set the same way distributors do it (durable across the
+# remote-settings-driven, locale/region search config), rather than a plain
+# pref that config sync could clobber.
+FINAL_TARGET_FILES.distribution += [
+    "policies.json",
+]
