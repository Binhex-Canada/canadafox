index 0000000000..1ba586202b
--- /dev/null
+++ b/browser/modules/CanadaFoxGeoIP.sys.mjs
@@ -0,0 +1,190 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * Looks up which country served the page, so the site-information panel can
+ * show a "Served from" line.
+ *
+ * This answers "which server replied", not "where does this company keep my
+ * data" -- a US site behind a CDN commonly answers from a Canadian edge node.
+ * The UI is worded accordingly.
+ *
+ * The database is DB-IP's IP-to-Country Lite, repacked into sorted range
+ * starts plus a country index (see vendor/geoip/README.md). It is loaded
+ * lazily on the first lookup and kept in memory afterwards.
+ */
+
+const DB_URL = "chrome://branding/content/dbip-country.bin";
+const MAGIC = "CFGEO1\0\0";
+
+export const CanadaFoxGeoIP = {
+  _db: null,
+  _loading: null,
+
+  /**
+   * Results are keyed by BrowsingContext rather than by the <browser>
+   * element: a navigation that changes process (notably going from
+   * about:canadafoxnewtab to a web page, i.e. opening a new tab and typing
+   * an address) hands the observer a different element than the one the
+   * panel later reads, so a per-element property silently went missing.
+   * The BrowsingContext survives those switches.
+   */
+  _byContext: new WeakMap(),
+
+  setCountryForContext(browsingContext, code) {
+    if (browsingContext) {
+      this._byContext.set(browsingContext, code);
+    }
+  },
+
+  getCountryForContext(browsingContext) {
+    return browsingContext ? this._byContext.get(browsingContext) ?? null : null;
+  },
+
+  async _load() {
+    let buffer = await (await fetch(DB_URL)).arrayBuffer();
+    let view = new DataView(buffer);
+
+    let magic = "";
+    for (let i = 0; i < MAGIC.length; i++) {
+      magic += String.fromCharCode(view.getUint8(i));
+    }
+    if (magic != MAGIC) {
+      throw new Error("Unrecognized geoip database format");
+    }
+
+    let offset = MAGIC.length;
+    let countryCount = view.getUint32(offset, true);
+    offset += 4;
+
+    let countries = [];
+    for (let i = 0; i < countryCount; i++) {
+      let code = String.fromCharCode(
+        view.getUint8(offset),
+        view.getUint8(offset + 1)
+      );
+      countries.push(code.replace("\0", ""));
+      offset += 2;
+    }
+    offset = (offset + 7) & ~7;
+
+    // slice() copies, which keeps the typed arrays aligned regardless of
+    // where the sections happen to land in the file.
+    let readSection = (count, bytesPer, Ctor) => {
+      let starts = new Ctor(buffer.slice(offset, offset + count * bytesPer));
+      offset += count * bytesPer;
+      let index = new Uint8Array(buffer.slice(offset, offset + count));
+      offset += count;
+      return { starts, index };
+    };
+
+    let v4Count = view.getUint32(offset, true);
+    offset += 8;
+    let v4 = readSection(v4Count, 4, Uint32Array);
+    offset = (offset + 7) & ~7;
+
+    let v6Count = view.getUint32(offset, true);
+    offset += 8;
+    let v6 = readSection(v6Count, 8, BigUint64Array);
+
+    this._db = { countries, v4, v6 };
+  },
+
+  /**
+   * @param {string} address A bare IPv4 or IPv6 address, as reported by
+   *   nsIHttpChannelInternal.remoteAddress.
+   * @returns {Promise<string|null>} An ISO 3166-1 alpha-2 country code, or
+   *   null if the address is unknown, private, or malformed.
+   */
+  async lookup(address) {
+    if (!address) {
+      return null;
+    }
+    if (!this._db) {
+      this._loading ??= this._load();
+      try {
+        await this._loading;
+      } catch (ex) {
+        console.error("CanadaFox: geoip database unavailable:", ex);
+        return null;
+      }
+    }
+
+    let key, section;
+    if (address.includes(":")) {
+      key = this._packIPv6(address);
+      section = this._db.v6;
+    } else {
+      key = this._packIPv4(address);
+      section = this._db.v4;
+    }
+    if (key === null) {
+      return null;
+    }
+
+    // Ranges are contiguous and sorted, so the match is the last range whose
+    // start is <= the address.
+    let lo = 0;
+    let hi = section.starts.length - 1;
+    let found = -1;
+    while (lo <= hi) {
+      let mid = (lo + hi) >> 1;
+      if (section.starts[mid] <= key) {
+        found = mid;
+        lo = mid + 1;
+      } else {
+        hi = mid - 1;
+      }
+    }
+    if (found < 0) {
+      return null;
+    }
+    let code = this._db.countries[section.index[found]];
+    // DB-IP uses ZZ for addresses it cannot place.
+    return code && code != "ZZ" ? code : null;
+  },
+
+  _packIPv4(address) {
+    let parts = address.split(".");
+    if (parts.length != 4) {
+      return null;
+    }
+    let value = 0;
+    for (let part of parts) {
+      let octet = Number(part);
+      if (!Number.isInteger(octet) || octet < 0 || octet > 255) {
+        return null;
+      }
+      value = value * 256 + octet;
+    }
+    return value;
+  },
+
+  _packIPv6(address) {
+    // Only the high 64 bits are needed: country allocations are never
+    // finer-grained than a /64.
+    let [head, tail = ""] = address.split("::");
+    let headGroups = head ? head.split(":") : [];
+    let tailGroups = tail ? tail.split(":") : [];
+    if (address.includes("::")) {
+      let missing = 8 - headGroups.length - tailGroups.length;
+      if (missing < 0) {
+        return null;
+      }
+      headGroups = headGroups.concat(Array(missing).fill("0"), tailGroups);
+    }
+    if (headGroups.length != 8) {
+      return null;
+    }
+    let value = 0n;
+    for (let i = 0; i < 4; i++) {
+      let group = parseInt(headGroups[i] || "0", 16);
+      if (!Number.isInteger(group) || group < 0 || group > 0xffff) {
+        return null;
+      }
+      value = (value << 16n) | BigInt(group);
+    }
+    return value;
+  },
+};
