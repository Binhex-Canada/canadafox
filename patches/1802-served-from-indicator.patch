+
+// CanadaFox: record which country answered each top-level page load, for the
+// "Served from" line in the site-information panel. Reads the remote address
+// off the document channel -- no extra network request, and the lookup runs
+// against a database bundled in the app, so producing it sends nothing about
+// browsing off the machine.
+var CanadaFoxServedFrom = {
+  init() {
+    Services.obs.addObserver(this, "http-on-examine-response");
+    window.addEventListener(
+      "unload",
+      () => Services.obs.removeObserver(this, "http-on-examine-response"),
+      { once: true }
+    );
+  },
+
+  observe(subject) {
+    let channel = subject.QueryInterface(Ci.nsIHttpChannel);
+    let loadInfo = channel.loadInfo;
+    if (loadInfo.externalContentPolicyType != Ci.nsIContentPolicy.TYPE_DOCUMENT) {
+      return;
+    }
+    // Top-level documents only; a subframe's host says nothing about the page
+    // the user thinks they are on.
+    let browsingContext = loadInfo.browsingContext;
+    if (!browsingContext || browsingContext.parent) {
+      return;
+    }
+    // topChromeWindow, not embedderElement.ownerGlobal: the element handed to
+    // an observer does not expose ownerGlobal, so comparing it silently
+    // rejected every load.
+    if (browsingContext.topChromeWindow != window) {
+      return;
+    }
+
+    let address;
+    try {
+      address = channel.QueryInterface(Ci.nsIHttpChannelInternal).remoteAddress;
+    } catch (ex) {
+      // Not every channel exposes one (cached or replayed responses).
+      return;
+    }
+
+    CanadaFoxGeoIP.setCountryForContext(browsingContext, null);
+    CanadaFoxGeoIP.lookup(address).then(code => {
+      CanadaFoxGeoIP.setCountryForContext(browsingContext, code);
+    });
+  },
+};
