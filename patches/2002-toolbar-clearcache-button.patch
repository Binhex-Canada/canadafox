diff --git a/browser/base/content/browser.js b/browser/base/content/browser.js
index 129acf3c76..1f8d07a5a9 100644
--- a/browser/base/content/browser.js
+++ b/browser/base/content/browser.js
@@ -5137,3 +5137,59 @@ var CanadaFoxTaxCalculator = {
     document.getElementById("canadafox-tax-amount").focus();
   },
 };
+
+// CanadaFox: the toolbar "clear cache" button. Deliberately a confirm-first
+// action rather than a single click, since it's a one-way, no-undo action --
+// the panel exists so a stray click doesn't silently clear the cache.
+var CanadaFoxClearCache = {
+  init() {
+    document
+      .getElementById("canadafox-clearcache-button-inner")
+      .addEventListener("click", event => this.togglePanel(event));
+  },
+
+  _initialized: false,
+
+  _initPanel() {
+    if (this._initialized) {
+      return;
+    }
+    this._initialized = true;
+
+    document
+      .getElementById("canadafox-clearcache-cancel-button")
+      .addEventListener("command", () => this._hide());
+    document
+      .getElementById("canadafox-clearcache-confirm-button")
+      .addEventListener("command", () => this._clear());
+  },
+
+  _hide() {
+    document.getElementById("canadafox-clearcache-panel").hidePopup();
+  },
+
+  _clear() {
+    const confirmButton = document.getElementById(
+      "canadafox-clearcache-confirm-button"
+    );
+    confirmButton.disabled = true;
+    Services.clearData.deleteData(Ci.nsIClearDataService.CLEAR_ALL_CACHES, () => {
+      confirmButton.disabled = false;
+      const statusEl = document.getElementById("canadafox-clearcache-status");
+      document.l10n.setAttributes(statusEl, "canadafox-clearcache-done");
+      statusEl.hidden = false;
+      setTimeout(() => this._hide(), 1200);
+    });
+  },
+
+  togglePanel(event) {
+    this._initPanel();
+    const panel = document.getElementById("canadafox-clearcache-panel");
+    if (panel.state == "open" || panel.state == "showing") {
+      panel.hidePopup();
+      return;
+    }
+    document.getElementById("canadafox-clearcache-status").hidden = true;
+    panel.openPopup(event.target, "bottomright topright");
+  },
+};
