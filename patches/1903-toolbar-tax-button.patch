diff --git a/browser/base/content/browser.js b/browser/base/content/browser.js
index c9859153df..129acf3c76 100644
--- a/browser/base/content/browser.js
+++ b/browser/base/content/browser.js
@@ -5020,3 +5020,120 @@ var CanadaFoxServedFrom = {
     });
   },
 };
+
+// CanadaFox: the toolbar sales-tax calculator panel. General statutory
+// rates by province/territory -- kept in sync by hand with the address-bar
+// UrlbarProviderCanadianTax.sys.mjs and canada-newtab.html copies of the
+// same table, since each lives in a different privilege/architecture
+// boundary that can't easily share a single module.
+var CanadaFoxTaxCalculator = {
+  PROVINCE_TAX: [
+    ["ab", "Alberta", 5, 0, 0],
+    ["bc", "British Columbia", 5, 7, 0],
+    ["mb", "Manitoba", 5, 7, 0],
+    ["nb", "New Brunswick", 0, 0, 15],
+    ["nl", "Newfoundland and Labrador", 0, 0, 15],
+    ["ns", "Nova Scotia", 0, 0, 14],
+    ["nt", "Northwest Territories", 5, 0, 0],
+    ["nu", "Nunavut", 5, 0, 0],
+    ["on", "Ontario", 0, 0, 13],
+    ["pe", "Prince Edward Island", 0, 0, 15],
+    ["qc", "Quebec", 5, 9.975, 0],
+    ["sk", "Saskatchewan", 5, 6, 0],
+    ["yt", "Yukon", 5, 0, 0],
+  ],
+
+  init() {
+    document
+      .getElementById("canadafox-tax-button-inner")
+      .addEventListener("click", event => this.togglePanel(event));
+  },
+
+  _initialized: false,
+
+  _initPanel() {
+    if (this._initialized) {
+      return;
+    }
+    this._initialized = true;
+
+    const province = document.getElementById("canadafox-tax-province");
+    for (const [code, name] of this.PROVINCE_TAX) {
+      const option = document.createElement("option");
+      option.value = code;
+      option.textContent = name;
+      province.appendChild(option);
+    }
+    province.value = "on";
+
+    document
+      .getElementById("canadafox-tax-amount")
+      .addEventListener("input", () => this._update());
+    province.addEventListener("change", () => this._update());
+    document
+      .getElementById("canadafox-tax-copy")
+      .addEventListener("command", () => this._copy());
+  },
+
+  _formatCurrency(n) {
+    return n.toLocaleString(undefined, {
+      minimumFractionDigits: 2,
+      maximumFractionDigits: 2,
+    });
+  },
+
+  _update() {
+    const amount = parseFloat(
+      document.getElementById("canadafox-tax-amount").value
+    );
+    const resultEl = document.getElementById("canadafox-tax-result");
+    if (!Number.isFinite(amount) || amount <= 0) {
+      resultEl.textContent = "";
+      this._lastTotal = "";
+      return;
+    }
+
+    const provinceCode = document.getElementById(
+      "canadafox-tax-province"
+    ).value;
+    const [, name, gst, pst, hst] = this.PROVINCE_TAX.find(
+      row => row[0] == provinceCode
+    );
+    const total = amount + (amount * (gst + pst + hst)) / 100;
+
+    let breakdown;
+    if (hst) {
+      breakdown = `${hst}% HST`;
+    } else if (pst) {
+      breakdown = `${gst}% GST + ${pst}% PST`;
+    } else {
+      breakdown = `${gst}% GST`;
+    }
+
+    this._lastTotal = this._formatCurrency(total);
+    resultEl.textContent = `$${this._formatCurrency(
+      amount
+    )} + ${breakdown} (${name}) = $${this._lastTotal}`;
+  },
+
+  _copy() {
+    if (!this._lastTotal) {
+      return;
+    }
+    Cc["@mozilla.org/widget/clipboardhelper;1"]
+      .getService(Ci.nsIClipboardHelper)
+      .copyString(this._lastTotal);
+  },
+
+  togglePanel(event) {
+    this._initPanel();
+    const panel = document.getElementById("canadafox-tax-panel");
+    if (panel.state == "open" || panel.state == "showing") {
+      panel.hidePopup();
+      return;
+    }
+    panel.openPopup(event.target, "bottomright topright");
+    this._update();
+    document.getElementById("canadafox-tax-amount").focus();
+  },
+};
