diff --git a/browser/app/profile/firefox.js b/browser/app/profile/firefox.js
index 9496c9b8d5..717cbb110b 100644
--- a/browser/app/profile/firefox.js
+++ b/browser/app/profile/firefox.js
@@ -2516,6 +2516,14 @@ pref("toolkit.telemetry.updatePing.enabled", true);
 // Enables sending 'bhr' pings when the browser hangs.
 pref("toolkit.telemetry.bhrPing.enabled", true);
 
+// CanadaFox: suppress the legacy data-reporting-policy notification tab
+// (mozilla.org's privacy policy page) and its infobar fallback. First-run
+// content is instead handled entirely by startup.homepage_welcome_url
+// (see browser/branding/unofficial/pref/firefox-branding.js), which
+// replaces the default New Tab as the sole first-run tab instead of
+// opening alongside/underneath it.
+pref("datareporting.policy.firstRunURL", "");
+
 // Enable GMP support in the addon manager.
 pref("media.gmp-provider.enabled", true);
 
diff --git a/browser/branding/unofficial/pref/firefox-branding.js b/browser/branding/unofficial/pref/firefox-branding.js
index f22dd0a51c..f5f760879f 100644
--- a/browser/branding/unofficial/pref/firefox-branding.js
+++ b/browser/branding/unofficial/pref/firefox-branding.js
@@ -7,6 +7,29 @@
 pref("startup.homepage_override_url", "");
 pref("startup.homepage_welcome_url", "");
 pref("startup.homepage_welcome_url.additional", "");
+// CanadaFox: the Canadian welcome/quote page. BrowserGlue owns this tab's
+// whole lifecycle (see _maybeShowWelcomeTab): it makes sure the tab exists
+// and is pinned on every startup, and stops once the user closes it.
+// Deliberately NOT startup.homepage_welcome_url -- that fires only on a
+// profile's very first run, and having Firefox open it too would race with
+// BrowserGlue and leave a duplicate tab.
+pref("canadafox.welcomeTab.url", "about:canadafoxwelcome");
+
+// CanadaFox: about:home's startup cache assumes Activity Stream has been
+// constructed, but pointing new tabs at about:canadafoxnewtab (see
+// utilityOverlay.js) means nothing triggers that construction, so the cache
+// throws "AboutNewTab.activityStream is null" on every launch. The cache
+// only pre-renders about:home a little sooner, so turning it off is a
+// straight trade of a marginal startup optimization for a clean startup.
+pref("browser.startup.homepage.abouthome_cache.enabled", false);
+
+// CanadaFox: show the bookmarks toolbar by default, so the pre-loaded
+// Canadian Services folder is actually visible. Upstream defaults to
+// "newtab" (visible only on a new tab). Set as a default rather than
+// through distribution.ini's browser.showPersonalToolbar, which only
+// writes it on a profile's very first run and so misses existing ones.
+// Users can still change it from View > Toolbars as usual.
+pref("browser.toolbars.bookmarks.visibility", "always");
 // The time interval between checks for a new version (in seconds)
 pref("app.update.interval", 86400); // 24 hours
 // Give the user x seconds to react before showing the big UI. default=24 hours
