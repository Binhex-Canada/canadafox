diff --git a/browser/components/preferences/config/canadafox.mjs b/browser/components/preferences/config/canadafox.mjs
new file mode 100644
index 0000000000..e3676dc81c
--- /dev/null
+++ b/browser/components/preferences/config/canadafox.mjs
@@ -0,0 +1,36 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import { SettingGroupManager } from "chrome://browser/content/preferences/config/SettingGroupManager.mjs";
+
+// The settings referenced below (e.g. "lockPinnedTabs") are registered by
+// their own feature's config module (tabs-browsing.mjs); this page just
+// collects them in one place so they're easy to find, without moving them
+// out of their normal section.
+SettingGroupManager.registerGroups({
+  canadafoxIntro: {
+    l10nId: "canadafox-settings-intro-group",
+    headingLevel: 2,
+    items: [
+      {
+        id: "canadafoxIntroText",
+        l10nId: "canadafox-settings-intro",
+        control: "moz-message-bar",
+        controlAttrs: {
+          type: "info",
+        },
+      },
+    ],
+  },
+  canadafoxTabs: {
+    l10nId: "canadafox-settings-tabs-group",
+    headingLevel: 2,
+    items: [
+      {
+        id: "lockPinnedTabs",
+        l10nId: "lock-pinned-tabs",
+      },
+    ],
+  },
+});
