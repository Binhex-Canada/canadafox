# Build config for CanadaFox.
# Path is relative to firefox/ since MOZCONFIG is set to this file's absolute path.
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/../obj-canadafox

ac_add_options --enable-application=browser
ac_add_options --disable-crashreporter
ac_add_options --disable-tests

# Speeds up incremental/repeat local builds by caching compiled objects
# (C/C++ and Rust) across `mach build` runs, e.g. after `apply-patches.sh`
# resets and re-applies patches on top of an otherwise-unchanged tree.
ac_add_options --with-ccache=sccache
mk_add_options 'export RUSTC_WRAPPER=sccache'

# Link-Time Optimization: cross-translation-unit inlining and dead-code
# elimination at link time, for a faster/leaner binary than the default
# per-file optimization our "opt" build tier already does. "thin" (not
# "full") trades a little runtime performance for build parallelism --
# full LTO here would serialize most of the link step onto one core and
# roughly double or triple build time.
#
# Deliberately NOT using Mozilla's own release mozconfigs as a base for
# this: those also pull in --enable-official-branding, MOZILLA_OFFICIAL=1,
# and Google Safe Browsing/location-service API keyfiles we don't have and
# don't want tied into CanadaFox.
ac_add_options --enable-lto=thin

